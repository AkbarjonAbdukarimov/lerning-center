# Local development (backend runs on the host, Postgres from `docker compose up db`)
DATABASE_URL=postgresql://ttask:ttask@localhost:5432/ttask?schema=public
PORT=3000
# Allow the Vite dev server to call the API directly (optional — Vite proxy is used by default)
CORS_ORIGIN=http://localhost:5173
# Timezone used for "current month" and default payment date
TZ=Asia/Tashkent
