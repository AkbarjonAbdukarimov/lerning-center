# Used by docker-compose.yml. Copy to .env and adjust if needed.

POSTGRES_USER=ttask
POSTGRES_PASSWORD=ttask
POSTGRES_DB=ttask

# Host ports
APP_PORT=3000
DB_PORT=5432

# Fill the database with demo students/payments on first start (skipped if students exist)
SEED=true

# Timezone for "current month" and the default payment date
TZ=Asia/Tashkent
